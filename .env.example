# Supabase project (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated wallet addresses that can use /admin
ADMIN_WALLETS=YourPhantomWalletAddress

# Anti-farming: raters must hold at least this many of your token (the contract address set in /admin).
# Set to 0 to turn the check off.
MIN_TOKEN_HOLDING=0
# Solana RPC used for the holding check. The public endpoint is rate limited; use Helius/QuickNode etc. in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
